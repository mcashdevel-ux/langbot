{
  "_comment": "Copy to langbot.config.json (or point $LANGBOT_CONFIG at it) and keep only the keys you want to change. Every key is optional; anything omitted, misspelled, or of the wrong type falls back to the built-in default shown here.",

  "llm": {
    "base_url": "http://127.0.0.1:8080/v1",
    "model": "local-model",
    "temperature": 0.1,
    "max_retries": 10
  },

  "paths": {
    "checkpoint_db": "./memory/agent_checkpoints.db",
    "chroma_dir": "./memory/agent_memory_chroma",
    "scratch_dir": "./memory/agent_scratch",
    "tasks_dir": "./memory/agent_tasks",
    "vault_dir": "memory/vault",
    "log_file": "./memory/langbot.log"
  },

  "logging": {
    "level": "WARNING",
    "console": false,
    "max_bytes": 1000000,
    "backup_count": 3
  },

  "memory": {
    "collection_name": "agent_longterm_memory",
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "embedding_device": "cpu",
    "worker_queue_size": 50,
    "worker_batch_size": 5,
    "worker_shutdown_timeout": 10.0,
    "max_facts_per_turn": 5,
    "min_similarity": 0.3,
    "recall_overfetch": 4,
    "mmr_lambda": 0.7,
    "dedup_similarity": 0.95,
    "dedup_token_overlap": 0.6,
    "lexical_search": true,
    "max_tags": 5,
    "auto_tags": true,
    "non_distillable_tools": [
      "task_list", "task_status", "task_output", "task_kill", "task_start",
      "vault", "read_scratch", "glob_list"
    ]
  },

  "_distill_comment": "Memory distillation is tried on these hosted models in order, then on the local llm above. A tier is skipped when its api_key_env is unset or its published rate limits (rpm/rpd/tpm/tpd, 0 = no limit) leave no room; set \"tiers\": [] to distill locally only.",
  "distill": {
    "cooldown_seconds": 300,
    "temperature": 0.0,
    "timeout": 30,
    "reserve_output_tokens": 512,
    "tiers": [
      {
        "model": "openai/gpt-oss-120b",
        "base_url": "https://api.groq.com/openai/v1",
        "api_key_env": "GROQ_API_KEY",
        "rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000
      },
      {
        "model": "qwen/qwen3.6-27b",
        "base_url": "https://api.groq.com/openai/v1",
        "api_key_env": "GROQ_API_KEY",
        "rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000
      },
      {
        "model": "openai/gpt-oss-20b",
        "base_url": "https://api.groq.com/openai/v1",
        "api_key_env": "GROQ_API_KEY",
        "rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000
      }
    ]
  },

  "context": {
    "budget_tokens": 32768,
    "reserve_tokens": 8192,
    "compact_at": 0.7,
    "keep_last_messages": 12,
    "summary_max_chars": 1500,
    "chars_per_token": 4
  },

  "tools": {
    "read_inline_chars": 800,
    "grep_inline_lines": 12,
    "manyfiles_inline_chars": 2000,
    "max_output_chars": 8000,
    "dynamic_binding": true,
    "core": [
      "execute_shell_command", "read_any_file", "write_any_file",
      "patch_file", "search_web", "recall"
    ]
  },

  "web": {
    "search_snippet_chars": 160,
    "search_max_results": 5,
    "fetch_inline_chars": 900,
    "jina_timeout": 25,
    "jina_retry_on_429": 1,
    "searxng_settings_path": "/etc/searxng/settings.yml",
    "searxng_source_dir": ""
  },

  "routing": {
    "max_nudges_per_turn": 3,
    "recursion_limit": 100,
    "stagnation_guard": true,
    "stagnation_exempt_tools": ["task_status", "task_output", "task_list"]
  },

  "compat": {
    "repair_json_tool_calls": true,
    "repair_max_candidates": 20
  },

  "housekeeping": {
    "enabled": true,
    "scratch_max_age_days": 7,
    "scratch_max_total_mb": 512,
    "checkpoint_keep_threads": 20
  }
}
