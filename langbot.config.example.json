{
  "_comment": "Copy to langbot.config.json (or point $LANGBOT_CONFIG at it) and keep only the keys you want to change. Every key is optional; anything omitted, misspelled, or of the wrong type falls back to the built-in default shown here.",

  "llm": {
    "base_url": "http://127.0.0.1:8080/v1",
    "model": "local-model",
    "temperature": 0.1,
    "max_retries": 10
  },

  "paths": {
    "checkpoint_db": "./memory/agent_checkpoints.db",
    "chroma_dir": "./memory/agent_memory_chroma",
    "scratch_dir": "./memory/agent_scratch",
    "tasks_dir": "./memory/agent_tasks",
    "vault_dir": "memory/vault",
    "log_file": "./memory/langbot.log"
  },

  "logging": {
    "level": "WARNING",
    "console": false,
    "max_bytes": 1000000,
    "backup_count": 3
  },

  "memory": {
    "collection_name": "agent_longterm_memory",
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "embedding_device": "cpu",
    "worker_queue_size": 50,
    "worker_batch_size": 5,
    "worker_shutdown_timeout": 10.0,
    "max_facts_per_turn": 5,
    "min_similarity": 0.3,
    "recall_overfetch": 4,
    "mmr_lambda": 0.7,
    "dedup_similarity": 0.95,
    "dedup_token_overlap": 0.6,
    "lexical_search": true
  },

  "tools": {
    "read_inline_chars": 1500,
    "grep_inline_lines": 20,
    "manyfiles_inline_chars": 4000,
    "scratch_save_chars": 200000,
    "max_output_chars": 20000
  },

  "web": {
    "search_snippet_chars": 160,
    "search_max_results": 5,
    "fetch_inline_chars": 1800,
    "fetch_save_chars": 20000,
    "jina_timeout": 25,
    "jina_retry_on_429": 1,
    "searxng_settings_path": "/etc/searxng/settings.yml",
    "searxng_source_dir": ""
  },

  "routing": {
    "max_nudges_per_turn": 5
  },

  "compat": {
    "repair_json_tool_calls": true,
    "repair_max_candidates": 20
  }
}
